.PHONY: install pull-model start stop status list check

install:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 install

pull-model:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 pull-model

start:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 start

stop:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 stop

status:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 status

list:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 list

check:
	powershell -ExecutionPolicy Bypass -File tasks.ps1 check
