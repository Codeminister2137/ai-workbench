# Copy this file to `.env` for local secrets and machine-specific settings.
# Do not commit `.env`.
#
# Every key is optional until you use its feature; blank means disabled.
# Sections are tagged [required for X] or [optional]. Compare this file
# against your `.env` to see which keys a feature needs from you.
#
# Normal command path:
# .\scripts\repo-assistant.ps1 "YOUR REQUEST" --provider ollama --model qwen2.5-coder:14b --execute --start-ollama

# Default provider config used by BackendConfig.from_env().
# The repo-aware coding assistant currently receives provider/model from CLI
# flags, but these variables are available to provider examples and future apps.
AI_PROVIDER_KIND=ollama
AI_PROVIDER_MODEL=qwen2.5-coder:14b
AI_PROVIDER_BASE_URL=http://localhost:11434
AI_PROVIDER_TIMEOUT_SECONDS=60

# Hosted provider credentials [required for the matching provider route].
# Leave blank unless you intentionally use hosted providers.
# BackendConfig.from_env() uses AI_PROVIDER_API_KEY first, then the
# provider-specific key, so set only what you need.
AI_PROVIDER_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
REQUESTY_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
META_API_KEY=
OPENROUTER_API_KEY=
BASETEN_API_KEY=
# Event key is selected only by baseten_hackathon_config(), not personal-key fallback.
BASETEN_HACKATHON_API_KEY=
MODAL_API_KEY=

# Remote-operator serve [required for operator-serve and its morning replay].
# day_cycle open replays the serve command but cannot invent this token.
OPERATOR_ACCESS_TOKEN=

# Mail features [required for job-email outreach, loop-notify, mail digest].
# GMAIL_PASSWORD is a Google app password, never your login password.
GMAIL_EMAIL=
GMAIL_PASSWORD=

# Supervised loops [optional; built-in model defaults apply when blank].
SUPERVISOR_MODEL=
IMPLEMENTER_MODEL=

# Public research discovery. Inference still stays local.
# Tavily must be a free Researcher account with no pay-as-you-go allowance.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Set to 1 only after zero paid usage allowance and disabled auto-reload.
BRAVE_SEARCH_FREE_ONLY_CONFIRMED=0
# Set to 1 only if your account permits retaining results in saved transcripts.
BRAVE_SEARCH_STORAGE_ALLOWED=0

# Local Ollama model storage.
# Set this if your Ollama models are outside the default user directory.
# Single-quote Windows paths to preserve backslashes with uv --env-file.
# Where Ollama keeps models on YOUR machine, e.g. OLLAMA_MODELS='D:\AI\Ollama\models'.
# Leave unset to use the Ollama default.
OLLAMA_MODELS=

# Optional local command overrides for external coding-agent routes.
# Leave blank unless auto-discovery cannot find the executable you want.
CODEX_COMMAND=
ANTIGRAVITY_COMMAND=
GITHUB_COPILOT_COMMAND=
KIRO_COMMAND=
GEMINI_CLI_COMMAND=
GEMINI_NODE_COMMAND=

# Optional Codex config root override.
# Leave blank to let Codex use its normal config location.
CODEX_HOME=

# Optional Copilot BYOK overrides [optional; subscription billing otherwise].
# When set, Copilot usage is billed to your provider key, not the subscription.
COPILOT_PROVIDER_BASE_URL=
COPILOT_PROVIDER_API_KEY=

# Optional live-integration test gates [optional; default off].
# Set to 1 to let the matching tests/integration suite hit real endpoints.
AI_PROVIDER_RUN_HOSTED_INTEGRATION=0
AI_PROVIDER_RUN_OLLAMA_INTEGRATION=0
AI_PROVIDER_RUN_REQUESTY_FREE_INTEGRATION=0

# Remote-wake (WoL) monitoring [optional; blank disables the DDNS check].
# Bare DDNS hostname only (no scheme), e.g. your-host.ddns.net.
# Provider/router credentials stay in the router — never put them here.
WAKE_DDNS_HOSTNAME=
# PC network card MAC (shared WoL secret), e.g. AA:BB:CC:DD:EE:FF.
WAKE_MAC=
# Router WAN UDP port forwarded to the PC (WoL), e.g. 49912.
WAKE_WOL_PORT=
# Expected PC LAN IP for the drift check, e.g. 192.168.1.50.
# Blank disables the check (a downloader's LAN always differs).
WAKE_LAN_IP=

APOLLO_API_KEY=
PROSPEO_API_KEY=